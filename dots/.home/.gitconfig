[user]
	email = ajdeleverio20@gmail.com
	name = IstarVin
	signingkey = /home/aj/.ssh/id_rsa.pub
[url "https://github.com/"]
	insteadOf = gh:
[pull]
	rebase = false
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	default = current
[alias]
	undo = reset --soft HEAD^
[color]
	ui = auto
[core]
	autocrlf = input
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[gpg]
	format = ssh
[commit]
	gpgsign = true
